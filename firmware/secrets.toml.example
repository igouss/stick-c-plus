# firmware/secrets.toml — TEMPLATE (committed as .example; the real file is git-ignored).
#
# Copy to `firmware/secrets.toml` and fill in the real values, then build. The
# shared `net` crate's build.rs reads the [wifi] table and bakes the credentials
# into the image as compile-time env (WIFI_SSID / WIFI_PASSWORD); the host-monitor
# bin's build.rs reads [host_monitor] the same way. Nothing here is written to a
# tracked file, so the real secrets never enter git.
#
#   cp firmware/secrets.toml.example firmware/secrets.toml
#   $EDITOR firmware/secrets.toml      # real 2.4 GHz SSID + WPA2 password
#
# Real values are mirrored in Bitwarden (homelab vault). Never commit
# secrets.toml — the tree AND history must stay clean (qhw.7).

[wifi]
# 2.4 GHz network only — the ESP32 has no 5 GHz radio.
ssid = "your-2.4GHz-ssid"
password = "your-wpa2-password"

# The host monitor scrapes this node_exporter over HTTP. `host:port` — the exporter
# listens on :9100 by default. Not a secret (a LAN address), but it is device-/site-
# specific, so it rides the git-ignored secrets file rather than being committed.
[host_monitor]
address = "192.168.1.10:9100"

# [noise] — the ESPHome native-API encryption PSK lands in qhw.10; it will live
# here too (a base64 32-byte key), git-ignored alongside the WiFi creds.
