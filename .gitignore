/target
/firmware/target
# esp-idf-sys stages the whole ESP-IDF checkout + Xtensa toolchains here (~2 GB,
# workspace-local install dir). Pure build artifact; re-fetchable from the pins.
/firmware/.embuild
# The GENERATED sdkconfig is derived from sdkconfig.defaults each build; the
# defaults file is the committed source of truth, the generated one is not.
/firmware/sdkconfig
/firmware/sdkconfig.old
**/*.rs.bk
*.pdb

# proptest regression seeds are worth committing; keep them.
!**/proptest-regressions/

# Datasheets are large immutable binaries — fetched locally, not committed.
# The source note + kb/sources/<slug>/fetch.sh reproduce them.
/kb/sources/m5stickc-plus-datasheets/*.pdf
/kb/sources/m5-earth-unit/*.pdf

# The full upstream doc-page snapshot is re-fetchable (fetch.sh) and noisy — keep
# the hand-transcribed pinmap.md, not the whole page.
/kb/sources/m5stickc-plus-pinout/*.upstream.md

# Flash dumps pulled off the board for reference/verification — large, re-fetchable
# via espflash read-flash (see kb/experiments). Keep the recipe, not the bytes.
/kb/**/*.bin
# EXCEPTION: the factory image is NOT re-fetchable once we flash our own firmware —
# it is the one irreplaceable capture here, so it IS committed. Keep what you can't reobtain.
!/kb/sources/m5stickc-plus-factory-image/factory-full-4MB.bin

# bv (beads viewer) local config and caches
.bv/
