/target
/firmware/target
# esp-idf-sys stages the whole ESP-IDF checkout + Xtensa toolchains here (~2 GB,
# workspace-local install dir). Pure build artifact; re-fetchable from the pins.
/firmware/.embuild
# The GENERATED sdkconfig is derived from sdkconfig.defaults each build; the
# defaults file is the committed source of truth, the generated one is not.
/firmware/sdkconfig
/firmware/sdkconfig.old
**/*.rs.bk
*.pdb

# proptest regression seeds are worth committing; keep them.
!**/proptest-regressions/

# Datasheets are large immutable binaries — fetched locally, not committed.
# The source note + kb/sources/<slug>/fetch.sh reproduce them.
/kb/sources/m5stickc-plus-datasheets/*.pdf
/kb/sources/m5-earth-unit/*.pdf

# The full upstream doc-page snapshot is re-fetchable (fetch.sh) and noisy — keep
# the hand-transcribed pinmap.md, not the whole page.
/kb/sources/m5stickc-plus-pinout/*.upstream.md

# Flash dumps pulled off the board for reference/verification — large, re-fetchable
# via espflash read-flash (see kb/experiments). Keep the recipe, not the bytes.
/kb/**/*.bin
# EXCEPTION: the factory image is NOT re-fetchable once we flash our own firmware —
# it is the one irreplaceable capture here, so it IS committed. Keep what you can't reobtain.
!/kb/sources/m5stickc-plus-factory-image/factory-full-4MB.bin

# Firmware secrets — WiFi credentials (qhw.7) and the future Noise API PSK
# (qhw.10). Real values live ONLY here, git-ignored, mirrored in Bitwarden; the
# committed source of truth is secrets.toml.example. build.rs bakes these into
# the image via env, so they never reach a tracked file. Never commit them: the
# tree AND history must stay clean (qhw.7 acceptance).
/firmware/secrets.toml
secrets.toml
/firmware/noise_psk.txt
*.psk

# bv (beads viewer) local config and caches
.bv/

# The aioesphomeapi conformance-oracle venv, provisioned by `just oracle`. A local
# dev tool (aioesphomeapi is not a Cargo dep); re-creatable, so never committed.
/.oracle-venv

# Claude Code runtime files — machine-local state (locks, schedules, worktrees,
# agent registry). These were ignored only via .git/info/exclude, which is NOT
# shared across clones; promoted here so every checkout ignores them.
# settings.json IS committed (shared config); settings.local.json is personal.
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock
**/.claude/scheduled_tasks.json
**/.claude/routines/.state/
**/.claude/worktrees/
**/.claude/checkpoints/
**/.claude/mailbox/
**/.claude/agent-registry.json
**/.claude/agent-memory-local
**/.claude/first-run
**/.claude/assistant-daemon-state.json
