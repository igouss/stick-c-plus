#!/usr/bin/env bash
# stick-c-plus quality bar — the automated, reproducible, per-arm mechanical gate the
# directory-algorithm dispatcher runs (kbe ADR-0007). Committed so every run worktree
# inherits the SAME bar; the champion stays generic and dispatches to this.
#
# SCOPE: the host chain only — the change's heart (the pure Pulse transform + the display)
# and the architecture edges. Fast, reproducible, isolation-/container-safe; writes only a
# small host target/ (no multi-GB esp toolchain in the run).
#
# Firmware, flash, and the live /pulse smoke are the operator WITNESS step — run OUT of band
# so we REUSE the prepared toolchain and WASTE NO SPACE. A fresh run worktree has no
# firmware/.embuild, so building there can only REBUILD ESP-IDF (~6GB) per run — the opposite
# of reuse (kbe ADR-0008; each project will package its stage tooling in a container later).
# Verify an arm's firmware on the WARM main checkout, which already has .embuild + target:
#     git -C <main-checkout> checkout <arm-branch> && just build-host-monitor  # reuses 6GB, fast
#     curl -H "Authorization: Bearer $HOSTPULSE_TOKEN" http://10.0.0.10:9099/pulse | jq
#     just flash    # eyeball the three host rows
#
# Run from the project worktree root (the dispatcher's cwd). Fail-closed.
set -euo pipefail

just test        # cargo test --workspace (host-core Pulse transform, host-display layout, ...)
just lint        # cargo clippy --workspace -- -D warnings
just hex-lint    # hexagonal role + bounded-context edges, BOTH workspaces
just audit       # effect-audit --strict --require-domain (functional-core purity)
