#!/usr/bin/env bash
# stick-c-plus pre-commit gate — formatting (rustfmt) + hexagonal role/context
# boundaries (hex-lint, ~/code/tools) before a commit lands. Fast: no compile.
# Install with `just setup-hooks` (points core.hooksPath here). Bypass in a pinch
# with `git commit -n`.
set -euo pipefail
export PATH="$HOME/.cargo/bin:$PATH"
cd "$(git rev-parse --show-toplevel)"
exec just precommit
